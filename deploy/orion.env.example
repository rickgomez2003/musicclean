# Core runtime
MUSICCLEAN_ORION_DATABASE=/var/lib/musicclean/orion.db
MUSICCLEAN_ORION_HOST=0.0.0.0
MUSICCLEAN_ORION_PORT=8765
MUSICCLEAN_ORION_LOG_LEVEL=info
MUSICCLEAN_ORION_STARTUP_RECONCILE=true

# Security
# Required when binding to a non-local address.
MUSICCLEAN_ORION_API_KEY=change-me
MUSICCLEAN_ORION_PUBLIC_HEALTH=true
MUSICCLEAN_ORION_ALLOWED_HOSTS=localhost,127.0.0.1,orion
MUSICCLEAN_ORION_MAX_REQUEST_BYTES=1048576

# Deployment paths
MUSICCLEAN_ORION_STATE_DIR=/var/lib/musicclean
MUSICCLEAN_ORION_LOG_DIR=/var/log/musicclean
MUSICCLEAN_ORION_TELEMETRY_DIR=/var/lib/musicclean/telemetry

# Optional JSONL telemetry
MUSICCLEAN_ORION_TELEMETRY_JSONL=/var/lib/musicclean/telemetry/events.jsonl

# Optional OpenTelemetry
# MUSICCLEAN_ORION_OTEL_ENDPOINT=http://otel-collector:4318/v1/traces
MUSICCLEAN_ORION_OTEL_SERVICE_NAME=musicclean-orion
