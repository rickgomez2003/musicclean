[Unit]
Description=MusicClean Orion Runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=musicclean
Group=musicclean
WorkingDirectory=/opt/musicclean
EnvironmentFile=/etc/musicclean/orion.env
ExecStart=/opt/musicclean/.venv/bin/python -m musicclean.orion.runtime
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/musicclean /var/log/musicclean

[Install]
WantedBy=multi-user.target
